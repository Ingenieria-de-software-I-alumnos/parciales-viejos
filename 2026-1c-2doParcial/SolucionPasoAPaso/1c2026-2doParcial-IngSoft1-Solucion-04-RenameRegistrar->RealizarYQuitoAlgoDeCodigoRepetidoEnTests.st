	estado := #EstadoEnCuarentena! !

!Brigada methodsFor: 'as yet unclassified' stamp: 'LL 6/10/2026 20:34:11'!
realizarAtencion: atencionSanitaria

	estado = #EstadoEnCuarentena ifTrue: [ self error: self noSePuedeRealizarAtencionEnCuarentenaMensajeDeError ].

	atencionesRealizadas add: atencionSanitaria! !

!Brigada methodsFor: 'as yet unclassified' stamp: 'LL 6/10/2026 20:22:57'!
tieneRegistrada: atencionSanitaria 
